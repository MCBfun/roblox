-- ==========================================================
-- 组合脚本：玩家/NPC 队伍透视 + FH_ScrapWorld 物品分批平滑透视 (防卡死+动态加载修复版)
-- ==========================================================
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ================= Part 1: 队伍透视（玩家=蓝色，NPC=红色） =================
local highlights = {}
local currentColors = {}

local function isNPC(model)
    if not model:IsA("Model") then return false end
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    return true
end

local function getColorForCharacter(character)
    local player = Players:GetPlayerFromCharacter(character)
    if player then
        return Color3.fromRGB(0, 150, 255) -- 玩家=蓝色
    end
    if isNPC(character) then return Color3.fromRGB(255, 0, 0) end -- NPC=红色
    return nil
end

local function applyHighlight(character, color)
    local highlight = highlights[character]
    if highlight then
        if currentColors[character] ~= color then
            highlight.FillColor = color
            highlight.OutlineColor = color
            currentColors[character] = color
        end
    else
        highlight = Instance.new("Highlight")
        highlight.Name = "TeamHighlight"
        highlight.FillTransparency = 1
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Parent = character
        highlights[character] = highlight
        currentColors[character] = color
    end
end

local function updateTargetHighlight(character)
    if not character or not character.Parent then return end
    local color = getColorForCharacter(character)
    if color then applyHighlight(character, color) end
end

local function updateAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then pcall(function() updateTargetHighlight(char) end) end
    end
end

local function updateAllNPCs()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isNPC(obj) then pcall(function() updateTargetHighlight(obj) end) end
    end
end

local function trackPlayer(player)
    local function onCharacterAdded()
        task.wait(0.3)
        if player.Character then pcall(function() updateTargetHighlight(player.Character) end) end
    end
    if player.Character then onCharacterAdded() end
    player.CharacterAdded:Connect(onCharacterAdded)
end

workspace.DescendantAdded:Connect(function(descendant)
    if isNPC(descendant) then
        task.wait(0.3)
        pcall(function() updateTargetHighlight(descendant) end)
    end
end)

for _, player in ipairs(Players:GetPlayers()) do trackPlayer(player) end
Players.PlayerAdded:Connect(trackPlayer)

task.spawn(function()
    while true do
        task.wait(15)
        updateAllPlayers()
        updateAllNPCs()
    end
end)

task.wait(1)
updateAllPlayers()
updateAllNPCs()


-- ================= Part 2: FH_ScrapWorld 物品透视 (平滑与动态加载版) =================
local CONFIG = {
    TargetFolderPath = {"CurrentMap", "FH_ScrapWorld"},
    TextSize = 10,
    MaxDistance = 1500,
    DefaultColor = Color3.fromRGB(255, 255, 255),
    GlobalRefreshInterval = 5,
    ItemsPerFrame = 15 
}

-- [修复]: 移除 WaitForChild，改为实时检测目录是否存在，不再阻塞线程
local function GetTargetFolder()
    local current = Workspace
    for _, folderName in ipairs(CONFIG.TargetFolderPath) do
        current = current:FindFirstChild(folderName)
        if not current then return nil end
    end
    return current
end

local function GetObjectPosition(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        else
            local modelRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
            if modelRoot then
                return modelRoot.Position
            end
        end
    end
    return nil
end

local function GetRarityColor(item)
    local sparkle = item:FindFirstChild("FH_RaritySparkle", true)
    if sparkle then
        if sparkle:IsA("BasePart") then
            return sparkle.Color
        elseif sparkle:IsA("Light") or sparkle:IsA("Beam") or sparkle:IsA("ParticleEmitter") or sparkle:IsA("Trail") then
            local colorVal = sparkle.Color
            if typeof(colorVal) == "ColorSequence" then
                return colorVal.Keypoints[1].Value
            elseif typeof(colorVal) == "Color3" then
                return colorVal
            end
        elseif sparkle:IsA("Fire") or sparkle:IsA("Sparkles") then
            return sparkle.Color
        end
        pcall(function()
            if sparkle.Color and typeof(sparkle.Color) == "Color3" then
                return sparkle.Color
            end
        end)
    end
    return CONFIG.DefaultColor
end

local screenGui = LocalPlayer.PlayerGui:FindFirstChild("FH_RarityESP_Gui")
if screenGui then screenGui:Destroy() end

screenGui = Instance.new("ScreenGui")
screenGui.Name = "FH_RarityESP_Gui"
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer.PlayerGui

local activeLabels = {}
local activeHighlights = {}

local currentTrackedFolder = nil
local folderConnection = nil

local function AddHighlight(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    
    local highlight = item:FindFirstChild("FH_ItemHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "FH_ItemHighlight"
        highlight.Adornee = item
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0
        highlight.Parent = item
        activeHighlights[item] = highlight
    end
    
    local color = GetRarityColor(item)
    highlight.FillColor = color
    highlight.OutlineColor = color
end

local function CreateOrUpdateLabel(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    
    local label = activeLabels[item]
    if not label then
        label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 150, 0, 20)
        label.AnchorPoint = Vector2.new(0.5, 0.5)
        label.BackgroundTransparency = 1
        label.TextTransparency = 0.1
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextSize = CONFIG.TextSize
        label.Font = Enum.Font.SourceSansBold
        label.Visible = false
        label.Parent = screenGui
        
        activeLabels[item] = label
    end
    
    label.Text = item.Name
    label.TextColor3 = GetRarityColor(item)
    AddHighlight(item)
end

-- [修复重点]: 全局刷新与动态目录连接功能
local function RefreshAllItems()
    local folderObj = GetTargetFolder()
    
    -- 动态连接监听机制：当目录被动态创建时，自动挂载监听事件
    if folderObj ~= currentTrackedFolder then
        if folderConnection then
            folderConnection:Disconnect()
            folderConnection = nil
        end
        currentTrackedFolder = folderObj
        if currentTrackedFolder then
            folderConnection = currentTrackedFolder.ChildAdded:Connect(function(item)
                task.wait(0.2)
                CreateOrUpdateLabel(item)
            end)
        end
    end
    
    -- 如果当前场景中没有该目录（地图未加载或已被删），清理掉所有旧的透视，防止内存泄漏或乱码
    if not folderObj then
        for item, label in pairs(activeLabels) do
            label:Destroy()
            activeLabels[item] = nil
            if activeHighlights[item] then
                activeHighlights[item]:Destroy()
                activeHighlights[item] = nil
            end
        end
        return
    end
    
    -- 1. 新增/更新检测（分帧处理）
    local children = folderObj:GetChildren()
    for i, item in ipairs(children) do
        CreateOrUpdateLabel(item)
        if i % CONFIG.ItemsPerFrame == 0 then
            task.wait() 
        end
    end
    
    -- 2. 失效清理与二次更新检测（分帧处理）
    local count = 0
    for item, label in pairs(activeLabels) do
        if not item or not item.Parent then
            label:Destroy()
            activeLabels[item] = nil
            if activeHighlights[item] then
                activeHighlights[item]:Destroy()
                activeHighlights[item] = nil
            end
        else
            CreateOrUpdateLabel(item)
        end
        
        count = count + 1
        if count % CONFIG.ItemsPerFrame == 0 then
            task.wait()
        end
    end
end

-- 初始加载及周期刷新机制整合在协程内
task.spawn(function()
    while true do
        RefreshAllItems()
        task.wait(CONFIG.GlobalRefreshInterval)
    end
end)

-- 保持每帧定位的高性能循环（即使没有目录也不卡顿）
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local rootPos = root.Position

    for item, label in pairs(activeLabels) do
        if not item.Parent then
            label:Destroy()
            activeLabels[item] = nil
        else
            local pos = GetObjectPosition(item)
            if pos then
                local dist = (rootPos - pos).Magnitude
                if dist <= CONFIG.MaxDistance then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
                    if onScreen then
                        label.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                        label.Visible = true
                    else
                        label.Visible = false
                    end
                else
                    label.Visible = false
                end
            else
                label.Visible = false
            end
        end
    end
end)

